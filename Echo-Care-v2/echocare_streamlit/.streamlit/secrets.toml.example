# Copy this file to .streamlit/secrets.toml and fill in your keys.
# On Streamlit Community Cloud: paste the same into your app's Settings -> Secrets box.
#
# This app uses exactly two external APIs by design:
GOOGLE_API_KEY = "your-google-ai-studio-key-here"
TAVILY_API_KEY = "your-tavily-key-here"

# Optional: comma-separated emails allowed on the Admin dashboard.
# If left unset, the FIRST account ever registered becomes the admin.
ADMIN_EMAILS = "you@example.com"
